{
  "name": "bearly-secure",
  "version": "0.1.0",
  "private": true,
  "description": "Intentionally vulnerable starter app for Boot.dev's Web Security course",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "format": "oxfmt",
    "lint": "oxfmt --check && oxlint && stylelint '**/*.css'",
    "lint:fix": "npm run format && oxlint --fix && stylelint --fix '**/*.css'",
    "seed": "node src/db/seed.ts",
    "start": "node src/server.ts",
    "typecheck": "tsgo"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.12.4",
    "@typescript/native-preview": "7.0.0-dev.20260602.1",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
